    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "koffi": "^2.15.2",
    "serialport": "13",
    "tray-hook": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
