{
  "name": "serialhub",
  "version": "0.1.0",
  "type": "module",
  "description": "Bidirectional bridge between serial ports and network connections (telnet/AI)",
  "author": "",
  "license": "MIT",
  "bin": {
    "serialhub": "./dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "serve": "bun run src/server.ts",
    "mcp": "bun run src/index.ts mcp",
    "start:node": "tsx src/index.ts",
    "serve:node": "tsx src/server.ts",
    "mcp:node": "tsx src/index.ts mcp",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "serialport": "13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
