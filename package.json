{
  "name": "serialhub",
  "version": "0.1.0",
  "type": "module",
  "description": "Bidirectional bridge between serial ports and network connections (telnet/AI)",
  "author": "",
  "license": "MIT",
  "bin": {
    "serialhub": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/server.ts",
    "mcp": "tsx src/index.ts mcp",
